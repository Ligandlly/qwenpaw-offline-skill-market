# 复制成 .env 后修改。任何一项改动都要重启后端（限额只认环境变量，见 PLAN §1）。

# 管理员账号：首次启动时若库为空则创建；库非空后修改这里不会改密码。
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-please

# 租户 runtime 访问后端的地址。必须是运行时视角下可达的 URL，
# 因为它会被写进 skill 的 install_url。
MARKET_PUBLIC_URL=http://market.internal:8080

# 宿主机映射端口
MARKET_PORT=8080

# 发布闸门限额（字节 / 个数 / 层级）
MARKET_MAX_BUNDLE_BYTES=2097152
MARKET_MAX_FILES=100
MARKET_MAX_FILE_BYTES=262144
MARKET_MAX_PATH_DEPTH=3
