# 模板。compose 部署复制成 deploy/.env（必须与 docker-compose.yml 同目录：compose 的
# env_file 与 ${VAR} 插值都以 compose 文件所在目录为基准）；systemd 裸机部署复制成
# /etc/offline-market/env。任何一项改动都要重启后端（限额只认环境变量，见 PLAN §1）。

# 管理员账号：首次启动时若库为空则创建；库非空后修改这里不会改密码。
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-please

# 租户 runtime 访问后端的地址。必须是 runtime 视角下可达的 URL，
# 因为它会被写进 skill 的 install_url，并作为安装时的归属校验依据：
# 必须与每个 runtime 的 OFFLINE_MARKET_URL 逐字符相同（见 docs/OPS.md §2.1）。
# 改这里只需重启后端，不需要重新发布技能。
MARKET_PUBLIC_URL=http://market.internal:8080

# 宿主机映射端口
MARKET_PORT=8080

# 发布闸门限额（字节 / 个数）
MARKET_MAX_BUNDLE_BYTES=2097152
MARKET_MAX_FILES=100
MARKET_MAX_FILE_BYTES=262144

# 日志级别：off / error / warn / info / debug / trace
# 排查问题时改成 debug，改完重启后端。
MARKET_LOG=info
